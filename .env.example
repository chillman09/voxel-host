# Admin account created on first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Panel web port
PORT=3000
# Public address shown to players (your VPS IP or domain)
PUBLIC_HOST=
# Ports Minecraft servers may use, e.g. "19007" or "25565-25570,19007"
PORT_POOL=19007
# Limits per customer account
MAX_SERVERS_PER_USER=1
MAX_RAM_MB=1024
MAX_UPLOAD_MB=300
# Set to false to close public sign-up
ALLOW_SIGNUP=true
# Path to java if it's not on PATH
JAVA_BIN=java
